{
  "name": "selfsubmit-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/reconcile-clerk-env.mjs && node scripts/ensure-direct-url.mjs && prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/ensure-direct-url.mjs && prisma generate",
    "db:generate": "dotenv -e .env.local -e .env -- prisma generate",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -e .env -- prisma db push",
    "db:studio": "dotenv -e .env.local -e .env -- prisma studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.3",
    "@prisma/client": "^6.4.1",
    "@vercel/blob": "^2.5.0",
    "archiver": "^8.0.0",
    "lucide-react": "^0.477.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
