# Clerk — https://dashboard.clerk.com → API Keys
# Copy to .env.local for local dev (never commit .env.local)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Use SelfSubmit pages (not Clerk hosted accounts.dev UI)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# UK address lookup (postcode → address dropdown)
# Option A: https://getaddress.io → Dashboard → API Keys (needs active subscription)
# Option B: https://ideal-postcodes.co.uk → API key (alternative provider)
# If neither works, the form still validates postcodes and accepts manual street entry (free).
# After changing .env.local you must restart: npm run dev
GETADDRESS_API_KEY=
IDEAL_POSTCODES_API_KEY=

# Prisma (SQLite) — subscription + businesses
# Path is relative to the frontend package root
DATABASE_URL="file:./prisma/dev.db"
