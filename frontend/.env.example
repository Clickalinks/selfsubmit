# Clerk — https://dashboard.clerk.com → API Keys
# Copy to .env.local for local dev (never commit .env.local)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Use SelfSubmit pages on YOUR domain (not Clerk Account Portal).
# Clerk Dashboard → Configure → Paths → choose "application domain" for Sign-in/Sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-up

# Optional — only if you proxy Clerk FAPI through your app domain (requires Clerk
# Dashboard → Domains → Frontend API → Set proxy configuration).
# SelfSubmit production uses clerk.selfsubmit.co.uk from the pk_live_ key — do NOT set this on Vercel.
# NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# App URL (production) — use www; apex selfsubmit.co.uk redirects to www in middleware
NEXT_PUBLIC_APP_URL=https://www.selfsubmit.co.uk

# Optional — Clerk production FAPI host (Dashboard → Domains). CSP also derives clerk.{APP_URL host}.
# CLERK_FAPI_URL=https://clerk.selfsubmit.co.uk

# Mandatory two-step verification (set false only for local testing)
MFA_REQUIRED=true

# Admin console (/admin) — comma-separated Clerk user IDs. When set, user must be admin+ AND listed.
# ADMIN_USER_IDS=user_xxxxxxxx

# Auto sign-out after inactivity (client-side guard; minutes)
# NEXT_PUBLIC_SESSION_INACTIVITY_MINUTES=30
# NEXT_PUBLIC_SESSION_WARN_MINUTES=2

# Clerk Dashboard → Configure → Sessions — also set inactivity timeout to match.

# AES-256 field encryption for UTR, NI numbers, HMRC OAuth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Error monitoring — Sentry project Client Keys (DSN)
# Use the same DSN for both. Set on Vercel Production (and Preview if useful).
# SENTRY_DSN=https://....@o....ingest.sentry.io/....
# NEXT_PUBLIC_SENTRY_DSN=https://....@o....ingest.sentry.io/....
# Optional later (source maps): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT

# PostgreSQL — production & local dev
# Example local (Docker): docker run --name selfsubmit-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=selfsubmit -p 5432:5432 -d postgres:16
# Native Windows install often uses 5433 if 5432 is already taken — check postgresql.conf or Services.
#
# Production (Vercel + Neon/Supabase/Vercel Postgres):
#   DATABASE_URL — pooled connection (PgBouncer / "-pooler" host). Used at runtime.
#   DIRECT_URL   — direct connection for Prisma migrations. Often same as DATABASE_URL locally.
# Example Neon pooled: postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Example Neon direct: postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/selfsubmit?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/selfsubmit?schema=public"

# Vercel Blob — receipt storage (required in production on Vercel)
# Vercel Dashboard → Storage → Blob → Connect to project (auto-sets BLOB_READ_WRITE_TOKEN)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Stripe — https://dashboard.stripe.com
# Create four recurring GBP prices, then paste Price IDs below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create four recurring GBP prices (Solo £20, Business Plus £36, Professional £52, Portfolio £70), then paste Price IDs below.
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_BUSINESS_PLUS=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_UNLIMITED=price_...
# Launch free trial for first-time Checkout subscribers (days). 90 ≈ 3 months. Set 0 to disable.
STRIPE_TRIAL_DAYS=90

# UK address lookup — Ideal Postcodes (pay-as-you-go)
# Server-side lookups: disable "Allowed URLs" on the key OR whitelist https://www.selfsubmit.co.uk
IDEAL_POSTCODES_API_KEY=ak_test_...

# Twilio SMS — deadline reminders (https://console.twilio.com)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+44...  (or use TWILIO_MESSAGING_SERVICE_SID=MG...)
# CRON_SECRET=  (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Vercel sends Authorization: Bearer <CRON_SECRET> when the daily cron runs.

# HMRC MTD (Phase 1 — register at https://developer.service.hmrc.gov.uk/)
# HMRC_CLIENT_ID=
# HMRC_CLIENT_SECRET=
# HMRC_REDIRECT_URI=https://www.selfsubmit.co.uk/api/hmrc/callback
# HMRC_API_BASE=https://test-api.service.hmrc.gov.uk
# Phase 3 sandbox quarterly submit (set true only when testing sandbox filing)
# HMRC_SANDBOX_FILING_ENABLED=true

# RESEND_API_KEY=re_...
# REMINDER_FROM_EMAIL=SelfSubmit <reminders@selfsubmit.co.uk>

# Clerk MFA (Dashboard → User & authentication → Multi-factor)
# Enable "Email verification code" and "Authenticator application".
# SelfSubmit enforces MFA in app code when MFA_REQUIRED=true.

# Clerk login protection webhook (Dashboard → Webhooks → Add endpoint)
# URL: https://your-domain.com/api/webhooks/clerk
# Events: session.created
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Stripe webhook (Dashboard → Developers → Webhooks)
# URL: https://your-domain.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted
# Use the signing secret from that endpoint for STRIPE_WEBHOOK_SECRET above.

# Clerk attack protection (Dashboard → User & authentication → Attack protection)
# Enable bot detection and brute-force protection alongside app-level lockouts.
